{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pironjulien/nexus-browser",
  "title": "NexusBrowser",
  "description": "Your real Chrome, driven in background tabs. Needs the NexusBrowser bridge and extension.",
  "version": "2.31.0",
  "websiteUrl": "https://julienpiron.fr/nexusbrowser/",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/pironjulien/NexusBrowser/main/plugins/nexus-browser/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    },
    {
      "src": "https://julienpiron.fr/nexusbrowser/assets/nexusbrowser-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/pironjulien/NexusBrowser",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "nexus-browser",
      "version": "2.31.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NEXUS_BROWSER_AGENT",
          "description": "Agent name used for the tab group (Claude, Codex, Antigravity...)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
