<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NexusBrowser</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>NexusBrowser</RootNamespace>
    <!-- Native AOT: release packages carry NexusBrowser.exe compiled ahead of time per architecture (no .NET to install,
         no JIT at start-up, a smaller resident daemon). The trimming, single-file and AOT analyzers run in every build
         and, with warnings as errors, no reflection-based JSON, `dynamic` COM or runtime-marshalled call can come back;
         reflection-based JSON is off in every build of the engine, so the tests run it the way the release does. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="tools.json" LogicalName="tools.json" />
    <EmbeddedResource Include="resources\garde-fous.json" LogicalName="garde-fous.json" />
    <EmbeddedResource Include="resources\trigger_probe.js" LogicalName="trigger_probe.js" />
    <EmbeddedResource Include="resources\webmcp_probe.js" LogicalName="webmcp_probe.js" />
    <EmbeddedResource Include="resources\bridge_config.json" LogicalName="bridge_config.json" />
    <EmbeddedResource Include="..\extension\manifest.json" LogicalName="extension-manifest.json" />
    <EmbeddedResource Include="..\extension\background.js" LogicalName="extension-background.js" />
    <EmbeddedResource Include="..\VERSION" LogicalName="VERSION" />
    <InternalsVisibleTo Include="NexusBrowser.Tests" />
    <PackageReference Include="Tomlyn" Version="2.10.2" />
  </ItemGroup>
  <!-- The engine ships no debug symbols (DebugType=none), packages' native ones included: SkiaSharp's libSkiaSharp.pdb
       (96 MB) stayed beside the single file, in every release package and installed version. -->
  <Target Name="DropPackageSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
